{
  "name": "@chentu/server",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm build && node --watch dist/index.js",
    "dev:compile": "tsc -p tsconfig.json --watch",
    "invite:create": "pnpm build && node dist/create-invite.js",
    "migrate": "pnpm build && node dist/migrate.js",
    "migrate:prod": "node dist/migrate.js",
    "start": "node dist/index.js",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
